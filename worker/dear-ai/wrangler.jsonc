{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dear-ai-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "placement": {
    "region": "aws:ap-northeast-2"
  },
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-4-6"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1701",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
