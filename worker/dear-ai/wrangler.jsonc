{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dear-ai-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "placement": {
    "region": "aws:ap-northeast-2"
  },
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-4-6",
    "PUBLIC_CHAT_ENABLED": "true",
    "CHAT_PROTECTIONS_ENABLED": "true",
    "DAILY_REQUEST_LIMIT": "200",
    "MONTHLY_REQUEST_LIMIT": "2000"
  },
  "durable_objects": { "bindings": [{ "name": "CHAT_BUDGET", "class_name": "ChatBudget" }] },
  "d1_databases": [
    {
      "binding": "CHAT_LOG",
      "database_name": "dear-chat-log",
      "database_id": "dd3c39d9-a53f-414e-b26f-8bf9f3536bf3"
    }
  ],
  "migrations": [{ "tag": "chat-budget-v1", "new_sqlite_classes": ["ChatBudget"] }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1701",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
